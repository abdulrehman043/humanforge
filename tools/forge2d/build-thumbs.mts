// Bakes one small WebP per selectable option so the native editor never renders SVG for a chip.
//   usage: tsx tools/forge2d/build-thumbs.mts      -> src/forge2d/native/thumbs/<category>/<option>.webp + thumbs.generated.ts
import sharp from 'sharp';
import { mkdirSync, rmSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import { renderAvatarSvg } from '../../src/forge2d/render';
import { DEFAULT_CONFIG } from '../../src/forge2d/defaults';
import { buildManifest } from '../../src/forge2d/manifest';
import { CROP, EDITOR_TABS, TINT_PATH, clone, previewBase, setPath, thumbTint } from '../../src/forge2d/editorModel';
import { hashId } from '../../src/forge2d/geom';

const OUT = path.resolve('src/forge2d/native/thumbs');
const W = 192; // px; chips are ~110dp, so this covers 1.75x and stays ~3-6 KB each
rmSync(OUT, { recursive: true, force: true });
const manifest = buildManifest();
const lines: string[] = [];
let n = 0, bytes = 0;
for (const tab of EDITOR_TABS) for (const sec of tab.sections) {
  if (sec.kind !== 'options') continue;
  const ids = manifest.filter((e) => e.category === sec.cat).map((e) => e.optionId);
  const list = sec.optional ? ['none', ...ids] : ids;
  const crop = CROP[sec.cat];
  for (let k = 0; k < list.length; k++) {
    const id = list[k];
    if (id === 'none') continue;
    const base = previewBase(sec.cat, clone(DEFAULT_CONFIG));
    let cfg = setPath(base, sec.path, id);
    const tint = thumbTint(sec.cat, id, k);
    if (tint) cfg = setPath(cfg, TINT_PATH[sec.cat], tint);
    const svg = renderAvatarSvg(cfg, { portable: true, fast: true, viewBox: crop, width: W, uid: `t${hashId(sec.cat + id)}` });
    const file = `${sec.cat}/${id}.webp`;
    mkdirSync(path.join(OUT, sec.cat), { recursive: true });
    const buf = await sharp(Buffer.from(svg), { density: 72 * (W / crop[2]) }).resize({ width: W }).webp({ quality: 82 }).toBuffer();
    writeFileSync(path.join(OUT, file), buf);
    lines.push(`  '${sec.cat}/${id}': require('./thumbs/${file}'),`);
    n++; bytes += buf.length;
  }
}
writeFileSync(path.resolve('src/forge2d/native/thumbs.generated.ts'),
  `// GENERATED by tools/forge2d/build-thumbs.mts (npm run build:thumbs-forge2d). Do not edit.\n// Option thumbnails, baked on the neutral preview base; the editor shows these instead of rendering SVG per chip.\nexport const THUMBS: Record<string, number> = {\n${lines.join('\n')}\n};\n`);
console.log(`wrote ${n} thumbs, ${(bytes / 1024).toFixed(0)} KB total`);
